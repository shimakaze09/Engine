// Template for the generated engine package/version identity header (issue
// #86 L-06). CMake substitutes the @…@ tokens from the root project()
// VERSION and writes engine_version.h into the build tree; this is engine
// package versioning, distinct from cooked-asset format versions (e.g.
// kMeshAssetVersion) which are unaffected and keep their own numbering.

#pragma once

#define ENGINE_VERSION_MAJOR @PROJECT_VERSION_MAJOR@
#define ENGINE_VERSION_MINOR @PROJECT_VERSION_MINOR@
#define ENGINE_VERSION_PATCH @PROJECT_VERSION_PATCH@
#define ENGINE_VERSION_STRING "@PROJECT_VERSION@"

namespace engine::core {

/// Returns the build-time "MAJOR.MINOR.PATCH" engine version string.
inline constexpr const char *engine_version_string() noexcept {
  return ENGINE_VERSION_STRING;
}

} // namespace engine::core
